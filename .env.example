# ==============================================================================
# AI RESEARCH AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# In-memory H2 database is used by default if DATABASE_URL is not set.
# For local PostgreSQL, set:
DATABASE_URL=jdbc:postgresql://localhost:5432/research_agent
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DRIVER=org.postgresql.Driver

# ------------------------------------------------------------------------------
# 2. AI MODEL CONFIGURATION (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Provider options: auto | gemini | openai
AI_PROVIDER=gemini

# Your AI API key (Google Gemini API Key or OpenAI API Key)
# Get Gemini API key at: https://aistudio.google.com/app/apikey
# Get OpenAI API key at: https://platform.openai.com/api-keys
AI_API_KEY=your_ai_api_key_here

# Optional model override
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. WEB SEARCH CONFIGURATION (DuckDuckGo / Tavily / Serper)
# ------------------------------------------------------------------------------
# Provider options: auto | duckduckgo | tavily | serper
# Default 'auto' uses DuckDuckGo with zero API key required, or Tavily/Serper if key is supplied.
SEARCH_PROVIDER=auto

# Optional Search API Key (for Tavily: https://tavily.com or Serper: https://serper.dev)
SEARCH_API_KEY=

# Max sources to retrieve per research query
SEARCH_MAX_RESULTS=6

# ------------------------------------------------------------------------------
# 4. NETWORKING & PORTS
# ------------------------------------------------------------------------------
PORT=8080
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
